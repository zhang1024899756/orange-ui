  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-tokens.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify:exports": "publint",
    "prepublishOnly": "pnpm build",
    "exports:sync": "node scripts/sync-exports.mjs",
    "docs:dev": "pnpm --filter @arvinzxy/orange-ui-docs dev",
    "docs:build": "pnpm --filter @arvinzxy/orange-ui-docs build",
    "docs:serve": "pnpm --filter @arvinzxy/orange-ui-docs serve"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.6",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
